{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && knip",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen:contracts": "json2ts -i ../schemas/karaoke.schema.json -o src/lib/contracts/generated/karaoke.ts --additionalProperties=false --unknownAny --ignoreMinAndMaxItems --style.useTabs --style.singleQuote --bannerComment '/* Generated from schemas/ by `pnpm gen:contracts`. Do not edit by hand. */' && json2ts -i ../schemas/theme.schema.json -o src/lib/contracts/generated/theme.ts --additionalProperties=false --unknownAny --ignoreMinAndMaxItems --style.useTabs --style.singleQuote --bannerComment '/* Generated from schemas/ by `pnpm gen:contracts`. Do not edit by hand. */'",
		"test:e2e": "playwright test",
		"test:e2e:server": "playwright test -c playwright.server.config.ts",
		"perf": "node scripts/perf-budget.mjs",
		"perf:frames": "node scripts/frame-budget.mjs",
		"gen:api": "openapi-typescript ../schemas/openapi.json -o src/lib/api/generated/openapi.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"json-schema-to-typescript": "16.0.0",
		"knip": "^5.88.1",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib/api": "./src/lib/api/index.js",
		"#lib/contracts": "./src/lib/contracts/index.js",
		"#lib/i18n": "./src/lib/i18n/index.svelte.js",
		"#lib/lyrics": "./src/lib/lyrics/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"lean-qr": "2.7.4",
		"signalsmith-stretch": "1.3.2"
	}
}
