# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to version control.
#
# Generate FLASK_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Flask
FLASK_SECRET_KEY=replace_with_output_of_secrets_token_hex_32
FLASK_DEBUG=false

# Redis (default works when running via docker-compose)
REDIS_URL=redis://redis:6379/0

# Postgres (defaults work when running via docker-compose)
POSTGRES_USER=karaoke
POSTGRES_PASSWORD=secret
POSTGRES_DB=karaoke
DATABASE_URL=postgresql+psycopg://karaoke:secret@postgres:5432/karaoke

# Ngrok tunnel — get your token at https://dashboard.ngrok.com
NGROK_AUTH_TOKEN=replace_with_your_ngrok_auth_token

# Storage backend: "local" (default) uses ./output volume; "r2" uploads to Cloudflare R2.
STORAGE_BACKEND=local
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET=karaoke-outputs
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Rate limiting and file size (optional — uncomment to override defaults)
# MAX_REQUESTS_PER_MINUTE=3
# MAX_FILE_SIZE_MB=100
