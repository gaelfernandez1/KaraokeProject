{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaelfernandez1/KaraokeProject/schemas/theme.schema.json",
  "$defs": {
    "ThemeAnimation": {
      "properties": {
        "fill": {
          "default": "wipe",
          "enum": [
            "wipe",
            "word"
          ],
          "type": "string"
        },
        "countdown_min_gap": {
          "default": 5.0,
          "description": "Instrumental gap (s) that triggers a countdown; 0 = off.",
          "minimum": 0,
          "type": "number"
        },
        "lead_in": {
          "default": 3.0,
          "description": "Seconds a block of lines shows before it is sung.",
          "minimum": 0,
          "type": "number"
        },
        "hold": {
          "default": 0.4,
          "description": "Seconds a sung line stays before its slot is reused.",
          "minimum": 0,
          "type": "number"
        },
        "transition": {
          "default": 0.25,
          "description": "Seconds of fades and scrolling.",
          "maximum": 2,
          "minimum": 0,
          "type": "number"
        },
        "anticipation": {
          "default": 0.05,
          "description": "Seconds the highlight runs ahead of the sound.",
          "maximum": 0.3,
          "minimum": 0,
          "type": "number"
        },
        "countdown_dots": {
          "default": 3,
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        },
        "countdown_step": {
          "default": 1.0,
          "description": "Seconds per dot.",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "type": "number"
        },
        "break_bar_min": {
          "default": 8.0,
          "description": "Gaps this long (s) show a progress bar; 0 = never.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "fill",
        "countdown_min_gap",
        "lead_in",
        "hold",
        "transition",
        "anticipation",
        "countdown_dots",
        "countdown_step",
        "break_bar_min"
      ],
      "title": "ThemeAnimation",
      "type": "object"
    },
    "ThemeBacking": {
      "description": "How backing vocals (lines with role \"backing\") look.",
      "properties": {
        "scale": {
          "default": 0.72,
          "maximum": 1,
          "minimum": 0.4,
          "type": "number"
        },
        "brackets": {
          "default": true,
          "type": "boolean"
        },
        "opacity": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "scale",
        "brackets",
        "opacity"
      ],
      "title": "ThemeBacking",
      "type": "object"
    },
    "ThemeColors": {
      "properties": {
        "sung": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "type": "string"
        },
        "unsung": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "type": "string"
        },
        "outline": {
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "type": "string"
        },
        "shadow": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "box": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "singers": {
          "description": "Sung colour of each singer, in order, when a song has two or more.",
          "items": {
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sung",
        "unsung",
        "outline",
        "shadow",
        "box",
        "singers"
      ],
      "title": "ThemeColors",
      "type": "object"
    },
    "ThemeFont": {
      "properties": {
        "family": {
          "minLength": 1,
          "type": "string"
        },
        "weight": {
          "default": 700,
          "maximum": 900,
          "minimum": 100,
          "type": "integer"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Font file bundled with the theme, if any."
        }
      },
      "required": [
        "family",
        "weight",
        "file"
      ],
      "title": "ThemeFont",
      "type": "object"
    },
    "ThemeLayout": {
      "properties": {
        "visible_lines": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "bottom",
            "center",
            "top"
          ],
          "type": "string"
        },
        "font_size": {
          "default": 0.06,
          "description": "Fraction of screen height.",
          "maximum": 0.2,
          "minimum": 0.02,
          "type": "number"
        },
        "line_spacing": {
          "default": 1.3,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "mode": {
          "default": "pages",
          "description": "pages: fixed rows that take turns (classic); scroll: a list that moves up.",
          "enum": [
            "pages",
            "scroll"
          ],
          "type": "string"
        },
        "margin": {
          "default": 0.05,
          "description": "Safe margin on each side, fraction of the screen.",
          "maximum": 0.2,
          "minimum": 0,
          "type": "number"
        },
        "min_row_chars": {
          "default": 22,
          "description": "The font shrinks so a row fits this many letters.",
          "maximum": 60,
          "minimum": 8,
          "type": "integer"
        },
        "max_rows": {
          "default": 2,
          "description": "Rows a long line may wrap into before shrinking.",
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "outline_width": {
          "default": 0.06,
          "description": "Fraction of the font size.",
          "minimum": 0,
          "type": "number"
        },
        "shadow_offset": {
          "default": 0.04,
          "description": "Fraction of the font size.",
          "minimum": 0,
          "type": "number"
        },
        "shadow_blur": {
          "default": 0.0,
          "description": "Fraction of the font size.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "visible_lines",
        "position",
        "font_size",
        "line_spacing",
        "mode",
        "margin",
        "min_row_chars",
        "max_rows",
        "outline_width",
        "shadow_offset",
        "shadow_blur"
      ],
      "title": "ThemeLayout",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "font": {
      "$ref": "#/$defs/ThemeFont"
    },
    "colors": {
      "$ref": "#/$defs/ThemeColors"
    },
    "layout": {
      "$ref": "#/$defs/ThemeLayout"
    },
    "animation": {
      "$ref": "#/$defs/ThemeAnimation"
    },
    "backing": {
      "$ref": "#/$defs/ThemeBacking"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "font",
    "colors",
    "layout",
    "animation",
    "backing"
  ],
  "title": "Theme",
  "type": "object"
}
