# WhisperX service image: transcription + forced alignment over HTTP on :5001.
# Teño documentado o por qué de cada versión, por se fose necesario para a memoria.
#
# Layer order matters: third-party deps install against an empty package stub, so a
# code change only busts the final `COPY .` — never the expensive dependency layers.
FROM pytorch/pytorch:2.3.0-cuda11.8-cudnn8-devel

ENV DEBIAN_FRONTEND=noninteractive
#arreglar problemas con variables de entorno intel mkl, polo tema de haber arreglado o de av.
ENV MKL_SERVICE_FORCE_INTEL=1
ENV MKL_THREADING_LAYER=INTEL
ENV OMP_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    wget \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /KaraokeProject

#versions compatibles en teoria
RUN pip install --no-cache-dir --upgrade \
    pip==24.0 \
    setuptools==69.5.1 \
    wheel==0.43.0

# Only pyproject.toml + an empty package stub before the dependency install, so
# editing source code below doesn't invalidate the conda/av/pip layers. The real
# code arrives with `COPY .` at the end; the editable install picks it up.
COPY pyproject.toml /KaraokeProject/
RUN mkdir -p src/karaoke src/whisperx_service \
    && touch src/karaoke/__init__.py src/whisperx_service/__init__.py

# faster-whisper 1.0.1 hard-pins av==11.*, and PyAV 11 ships no wheel for
# cp310, so pip must build it from source. PyAV 11 also needs FFmpeg >= 5
# (AV_CODEC_CAP_OTHER_THREADS), but Ubuntu 22.04's apt only has 4.4 and the
# pytorch base env carries FFmpeg 4.3 — both too old. The base image's default
# conda channels already ship ffmpeg 6.1.1, so install from there and build av
# against it. Avoid the conda-forge channel on purpose: its huge repodata blows
# up memory when several images build in parallel and crashes Docker Desktop on
# WSL2. Only the native FFmpeg libs come from conda — av stays pip-managed.
RUN conda install --solver=libmamba "ffmpeg=6" -y && conda clean -a -y
RUN PKG_CONFIG_PATH=/opt/conda/lib/pkgconfig \
    pip install --no-cache-dir "av==11.*"

# openai-whisper uses a legacy setup.py that imports pkg_resources, which is
# unavailable inside pip's isolated build env; install it first without isolation
RUN pip install --no-cache-dir --no-build-isolation openai-whisper==20231117
RUN pip install --no-cache-dir -e ".[whisperx]"

COPY . /KaraokeProject

RUN mkdir -p /data

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5001/health', timeout=4).read()" || exit 1

CMD ["python", "-m", "whisperx_service.api"]
